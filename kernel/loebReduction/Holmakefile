ifndef CAKEMLDIR
CAKEMLDIR = $(HOME)/dev/CakeML
endif
HOLHOL = $(CAKEMLDIR)/candle
# kernel/Holmakefile's INCLUDES plus ../ (= kernel/, for kernelUpgradeTheory):
# the reduction is stated over kernelUpgrade's OWN loeb_reflection /
# kernel_sound / candle_kernel, so it needs the Tier-2 kernel slice built.
INCLUDES = ../.. ../../embedded .. \
           $(CAKEMLDIR)/misc $(CAKEMLDIR)/basis/pure \
           $(HOLHOL)/syntax-lib $(HOLHOL)/set-theory \
           $(HOLHOL)/standard/syntax $(HOLHOL)/standard/semantics
OPTIONS = QUIT_ON_FAILURE
