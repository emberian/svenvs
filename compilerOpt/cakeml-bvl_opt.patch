diff --git a/compiler/backend/bvl_optScript.sml b/compiler/backend/bvl_optScript.sml
new file mode 100644
index 000000000..6a242d265
--- /dev/null
+++ b/compiler/backend/bvl_optScript.sml
@@ -0,0 +1,46 @@
+(*
+  A verified empty-Let elimination optimisation for the BVL language
+  (svenvs Layer B).  `optimise_one` recursively rewrites `Let [] e ~> e'`
+  (with e recursively optimised) and otherwise recurses structurally through
+  every constructor.  An empty Let binds nothing, so evaluating `Let [] e` is
+  the same as evaluating `e` in the same environment; the pass is therefore
+  semantics preserving (proved in bvl_optProofScript) and is wired in as a BVL
+  pre-pass in bvl_to_bvi$compile.
+
+  The pass is defined as a mutually-recursive (exp -> exp) / (exp list -> exp
+  list) pair, exactly the cv_translator-friendly idiom used by bvl_inline's
+  let_op_one / let_op_list.
+*)
+Theory bvl_opt
+Ancestors
+  bvl
+Libs
+  preamble
+
+Definition optimise_one_def:
+  (optimise_one (Var v) = Var v) /\
+  (optimise_one (If x1 x2 x3) =
+     If (optimise_one x1) (optimise_one x2) (optimise_one x3)) /\
+  (optimise_one (Let xs x2) =
+     if xs = [] then optimise_one x2
+     else Let (optimise_list xs) (optimise_one x2)) /\
+  (optimise_one (Raise x1) = Raise (optimise_one x1)) /\
+  (optimise_one (Handle x1 x2) = Handle (optimise_one x1) (optimise_one x2)) /\
+  (optimise_one (Op op xs) = Op op (optimise_list xs)) /\
+  (optimise_one (Tick x) = Tick (optimise_one x)) /\
+  (optimise_one (Force m n) = Force m n) /\
+  (optimise_one (Call ticks dest xs) = Call ticks dest (optimise_list xs)) /\
+  (optimise_list [] = []) /\
+  (optimise_list ((x:bvl$exp)::xs) = optimise_one x :: optimise_list xs)
+End
+
+Definition optimise_sing_def:
+  optimise_sing e = optimise_one e
+End
+
+(* The whole-program (per-function) optimiser used by bvl_to_bvi$compile. *)
+Definition optimise_prog_def:
+  optimise_prog prog = MAP (\(n,a,e). (n,a,optimise_one e)) prog
+End
+
+val _ = export_theory ();
