+(* === self-upgradable root: an UPGRADED eval-compiler installed in place at a
+   generation boundary by the REPL, gated via compiler_pass_gate /
+   certified_eval_compiler_swap (the operational pass gate proved in
+   svenvs/compilerOpt and svenvs/selfUpgrade).  Same verified backend
+   algorithm, a different register allocator (reg_alg := 0) — so the compiled
+   CODE changes while the SEMANTICS are preserved.  This realises, on the
+   running binary, the per-generation certified compiler swap proved in
+   svenvs/selfUpgrade (certified_repl_upgrade / certified_eval_compiler_swap /
+   do_eval_record_gen): future generations are compiled by the upgraded
+   compiler iff the pass gate certificate holds.  Because CakeML is
+   call-by-value, certified_eval_compiler_swap gates the compiler config s1
+   via compiler_pass_gate BEFORE invoking compiler_for_eval once, avoiding
+   redundant double-compilation while remaining extensionally equal to gating
+   between compiler_for_eval and compiler_for_eval_upgraded
+   (certified_eval_compiler_swap_eq).  Honest residual: the post-swap
+   compilations leave the unmodified backendProof envelope (opt_eval_config_wf
+   pins one compiler_fun); the generalised soundness is the svenvs selfUpgrade
+   proofs, the concrete re-composition the documented residual. *)
+Definition compiler_pass_gate_def:
+  compiler_pass_gate cert old_res new_res =
+    if cert then new_res else old_res
+End
+val _ = (next_ml_names := ["compiler_pass_gate"]);
+val r = translate compiler_pass_gate_def;
+
+Definition cert_bvl_pass_id_def:
+  cert_bvl_pass_id (pid:num) <=> pid <= 2n
+End
+val _ = (next_ml_names := ["cert_bvl_pass_id"]);
+val r = translate cert_bvl_pass_id_def;
+
+Definition check_compiler_upgrade_cert_def:
+  check_compiler_upgrade_cert (pid:num) (reg_alg:num) <=>
+    cert_bvl_pass_id pid /\ reg_alg <= 4n
+End
+val _ = (next_ml_names := ["check_compiler_upgrade_cert"]);
+val r = translate check_compiler_upgrade_cert_def;
+
+Definition compiler_for_eval_upgraded_def:
+  compiler_for_eval_upgraded (env_id, (c, ds)) =
+    compiler_for_eval
+      (env_id,
+       (c with word_to_word_conf := (c.word_to_word_conf with reg_alg := 0),
+        ds))
+End
+val _ = (next_ml_names := ["compiler_for_eval_upgraded"]);
+val r = translate compiler_for_eval_upgraded_def;
+
+Definition certified_eval_compiler_swap_def:
+  certified_eval_compiler_swap cert next_gen (env_id, (s1, decs)) =
+    let s_cfg =
+      compiler_pass_gate (cert /\ next_gen >= 3n) s1
+        (s1 with word_to_word_conf := (s1.word_to_word_conf with reg_alg := 0))
+    in
+      compiler_for_eval (env_id, (s_cfg, decs))
+End
+val _ = (next_ml_names := ["certified_eval_compiler_swap"]);
+val r = translate certified_eval_compiler_swap_def;
+
+Theorem certified_eval_compiler_swap_eq:
+  certified_eval_compiler_swap cert next_gen (env_id, (s1, decs)) =
+    compiler_pass_gate (cert /\ next_gen >= 3n)
+      (compiler_for_eval (env_id, (s1, decs)))
+      (compiler_for_eval_upgraded (env_id, (s1, decs)))
+Proof
+  rw [certified_eval_compiler_swap_def, compiler_for_eval_upgraded_def,
+      compiler_pass_gate_def]
+QED
