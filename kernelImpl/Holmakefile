# kernelImpl — closing the heavy link: the running verified Candle kernel's
# EXECUTABLE SYM function implements sym_kernel's new rule, soundly, via
# CakeML's OWN verified holKernelProof (SYM_thm + THM_def) — not new
# translator work. Needs the built CakeML candle monadic kernel, plus
# ../kernelMod (and the svenvs/candle-semantics layers it is built on) so the
# discharge in symBinaryImplements is of kernelMod's `sym_kernel` and
# inplaceUpdate's `binary_implements` themselves.
ifndef CAKEMLDIR
CAKEMLDIR = $(HOME)/dev/CakeML
endif
HOLHOL = $(CAKEMLDIR)/candle
INCLUDES = .. ../embedded ../kernel ../selfprover ../selfproverConcrete ../kernelMod \
           $(CAKEMLDIR)/misc $(CAKEMLDIR)/basis/pure $(CAKEMLDIR)/translator/monadic \
           $(HOLHOL)/syntax-lib $(HOLHOL)/set-theory \
           $(HOLHOL)/standard/syntax $(HOLHOL)/standard/semantics \
           $(HOLHOL)/standard/monadic
OPTIONS = QUIT_ON_FAILURE
